<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_control_scan"
            android:textStyle="bold"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/input_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/hint_scan_code"
            android:textSize="20sp"
            android:padding="12dp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#CCCCCC" />

        <TextView
            android:id="@+id/txt_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_result"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:shrinkColumns="1"
            android:stretchColumns="1"
            android:background="#EEEEEE"
            android:padding="12dp">

            <TableRow>

                <TextView
                    android:text="@string/label_id"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingEnd="16dp"
                    android:paddingStart="0dp" />

                <TextView
                    android:id="@+id/txt_card_id"
                    android:textSize="18sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:text="@string/label_name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingEnd="16dp"
                    android:paddingStart="0dp" />

                <TextView
                    android:id="@+id/txt_card_name"
                    android:textSize="18sp"
                    android:hyphenationFrequency="none" />
            </TableRow>

            <TableRow>

                <TextView
                    android:text="@string/label_price"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingEnd="16dp"
                    android:paddingStart="0dp" />

                <TextView
                    android:id="@+id/txt_card_price"
                    android:textSize="18sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:text="@string/label_quantity"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingEnd="16dp"
                    android:paddingStart="0dp" />

                <TextView
                    android:id="@+id/txt_card_quantity"
                    android:textSize="18sp" />
            </TableRow>

            <TableRow>

                <TextView
                    android:text="@string/label_ou"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingEnd="16dp"
                    android:paddingStart="0dp" />

                <TextView
                    android:id="@+id/txt_card_location"
                    android:textSize="18sp" />
            </TableRow>

        </TableLayout>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:textColor="@color/statusNeutral"
            android:text="@string/status_ready"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>