@startuml
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Uživatel" as U
actor "Administrátor" as A

rectangle "Systém pro správu majetku" {
    usecase "Správa majetkové karty" as UC1
    usecase "Správa příloh karet" as UC2
    usecase "Správa číselníků" as UC3
    usecase "Tisk etiket" as UC4
    usecase "Generování reportů" as UC5
    usecase "Sběr inventurních dat" as UC6
    usecase "Vyhodnocení inventury" as UC7
    usecase "Změna hesla" as UC8
    usecase "Vytvoření uživatelského\núčtu" as UC9
}

U -- UC1
U -- UC2
U -- UC3
U -- UC4
U -- UC5
U -- UC6
U -- UC7
U -- UC8

A -- UC9
A --|> U
@enduml
