@startuml activity-inventory
skinparam activityFontSize 13
skinparam activityDiamondFontSize 12
skinparam swimlaneTitleFontSize 14
skinparam swimlaneTitleFontStyle bold

title Inventurní proces

|Webová administrace|
start
:Založit novou inventuru;

|Mobilní aplikace|
:Přihlásit se k serveru;
:Stáhnout karty a lokace\ndo lokální Room databáze;

repeat
  :Naskenovat čárový kód umístění;
  note right: Prefix "L" = umístění
  repeat
    :Naskenovat čárový kód majetku;
    note right: Číselné ID = karta
    :Uložit záznam auditu\n(karta, umístění, čas)\ndo Room databáze;
  repeat while (Naskenovány všechny\nmajetky v dané\nmístnosti?) is (Ne) not (Ano)
repeat while (Naskenováno vše\nve všech\nmístnostech?) is (Ne) not (Ano)

:Nahrát inventurní data\nna server (POST);

|Webová administrace|
:Zobrazit rozdíly\n(diff evidovaného\nvs. naskenovaného stavu);

note right
  **Statusy:**
  CORRECT — umístění souhlasí
  WARN — umístění se liší
  WRONG — nenaskenováno
end note

:Odvodit výchozí akce;
note right
  CORRECT → KEEP (nelze změnit)
  WARN → RL (skutečné umístění)
  WRONG → bez akce (nutno zvolit)
end note

repeat
  if (Status karty?) then (CORRECT)
    :Akce = KEEP\n(zamčeno);
  elseif (WARN) then
    :Zvolit akci:\nSkutečné umístění /\nOčekávané umístění /\nVyřadit;
  else (WRONG)
    :Zvolit akci:\nOčekávané umístění /\nVyřadit;
  endif
  if (Akce = Vyřadit?) then (Ano)
    :Vyplnit datum\na způsob vyřazení;
  else (Ne)
  endif
repeat while (Všechny WRONG mají akci?\nVšechny vyřazené mají\ndatum a způsob?) is (Ne) not (Ano)


:Promítnout změny\ndo databáze;
stop

@enduml
